{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitposse7.local/schemas/pareamento.v2.schema.json",
  "title": "POST /v1/pareamento: pedido e resposta (v2)",
  "description": "protocolo.md §2, ADR-0024. Pareia o aparelho (não a equipe). A Central só responde depois de o operador confirmar ou recusar (espera de até 90 s).",
  "$defs": {
    "pedido": {
      "type": "object",
      "required": [
        "protocolo_versao",
        "schema_versao",
        "token_pareamento",
        "instalacao_uuid"
      ],
      "additionalProperties": false,
      "properties": {
        "protocolo_versao": {
          "const": 2
        },
        "schema_versao": {
          "const": 2
        },
        "token_pareamento": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "instalacao_uuid": {
          "$ref": "comum.v2.schema.json#/$defs/uuid"
        },
        "rotulo_aparelho": {
          "$ref": "comum.v2.schema.json#/$defs/textoOpcional"
        }
      }
    },
    "resposta": {
      "type": "object",
      "required": [
        "protocolo_versao",
        "central_id",
        "credencial_dispositivo"
      ],
      "additionalProperties": false,
      "properties": {
        "protocolo_versao": {
          "const": 2
        },
        "central_id": {
          "$ref": "comum.v2.schema.json#/$defs/uuid"
        },
        "credencial_dispositivo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "32 bytes aleatórios em base64url sem padding. A Central guarda só o SHA-256."
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/pedido"
    },
    {
      "$ref": "#/$defs/resposta"
    }
  ]
}
