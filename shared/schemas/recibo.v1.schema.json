{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitposse7.local/schemas/recibo.v1.schema.json",
  "title": "Recibo de importação de lote (v1)",
  "description": "protocolo.md §6. recibo_sha256 = SHA-256 (hex) do texto UTF-8 formado por lote_uuid, central_id e importado_em seguidos de uma linha por resultado 'entidade|uuid|rev|resultado|motivo' (motivo vazio quando ausente), na ordem do array, cada linha terminada por \\n.",
  "type": "object",
  "required": ["protocolo_versao", "lote_uuid", "central_id", "importado_em", "resultados", "recibo_sha256"],
  "additionalProperties": false,
  "properties": {
    "protocolo_versao": { "const": 1 },
    "lote_uuid": { "$ref": "comum.v1.schema.json#/$defs/uuid" },
    "central_id": { "$ref": "comum.v1.schema.json#/$defs/uuid" },
    "importado_em": { "$ref": "comum.v1.schema.json#/$defs/instante" },
    "resultados": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entidade", "uuid", "rev", "resultado"],
        "additionalProperties": false,
        "properties": {
          "entidade": { "enum": ["equipe", "propriedade", "item", "foto"] },
          "uuid": { "$ref": "comum.v1.schema.json#/$defs/uuid" },
          "rev": { "$ref": "comum.v1.schema.json#/$defs/rev" },
          "resultado": { "enum": ["aplicado", "duplicado", "conflito", "rejeitado"] },
          "motivo": { "type": "string" },
          "conflito_uuid": { "$ref": "comum.v1.schema.json#/$defs/uuid" }
        }
      }
    },
    "recibo_sha256": { "$ref": "comum.v1.schema.json#/$defs/sha256" }
  }
}
