{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitposse7.local/schemas/recibo.v2.schema.json",
  "title": "Recibo de importação de lote (v2)",
  "description": "protocolo.md §6 e §9, ADR-0024. recibo_sha256 = SHA-256 (hex) do texto UTF-8: lote_uuid, central_id e importado_em (uma linha cada), a linha 'destino|estudo_codigo|jornada_numero|jornada_data|equipe_codigo|codigo_informado|corrigido' (corrigido = true/false) e uma linha por resultado 'entidade|uuid|rev|resultado|motivo' (motivo vazio quando ausente), na ordem do array; cada linha terminada por \\n.",
  "type": "object",
  "required": [
    "protocolo_versao",
    "lote_uuid",
    "central_id",
    "importado_em",
    "destino",
    "resultados",
    "recibo_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolo_versao": {
      "const": 2
    },
    "lote_uuid": {
      "$ref": "comum.v2.schema.json#/$defs/uuid"
    },
    "central_id": {
      "$ref": "comum.v2.schema.json#/$defs/uuid"
    },
    "importado_em": {
      "$ref": "comum.v2.schema.json#/$defs/instante"
    },
    "resultados": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entidade",
          "uuid",
          "rev",
          "resultado"
        ],
        "additionalProperties": false,
        "properties": {
          "entidade": {
            "enum": [
              "coleta",
              "propriedade",
              "item",
              "foto"
            ]
          },
          "uuid": {
            "$ref": "comum.v2.schema.json#/$defs/uuid"
          },
          "rev": {
            "$ref": "comum.v2.schema.json#/$defs/rev"
          },
          "resultado": {
            "enum": [
              "aplicado",
              "duplicado",
              "conflito",
              "rejeitado"
            ]
          },
          "motivo": {
            "type": "string"
          },
          "conflito_uuid": {
            "$ref": "comum.v2.schema.json#/$defs/uuid"
          }
        }
      }
    },
    "recibo_sha256": {
      "$ref": "comum.v2.schema.json#/$defs/sha256"
    },
    "destino": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estudo_codigo",
        "estudo_nome",
        "jornada_numero",
        "jornada_data",
        "equipe_nome",
        "equipe_codigo",
        "codigo_informado",
        "corrigido"
      ],
      "properties": {
        "estudo_codigo": {
          "$ref": "comum.v2.schema.json#/$defs/codigoEstudo"
        },
        "estudo_nome": {
          "type": "string",
          "minLength": 1
        },
        "jornada_numero": {
          "type": "integer",
          "minimum": 1
        },
        "jornada_data": {
          "$ref": "comum.v2.schema.json#/$defs/data"
        },
        "equipe_nome": {
          "type": "string",
          "minLength": 1
        },
        "equipe_codigo": {
          "$ref": "comum.v2.schema.json#/$defs/codigoEquipe"
        },
        "codigo_informado": {
          "$ref": "comum.v2.schema.json#/$defs/codigoEquipe"
        },
        "corrigido": {
          "type": "boolean"
        }
      }
    }
  }
}
